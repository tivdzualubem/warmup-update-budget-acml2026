{
  "schema_version": 1,
  "status": "pre_experiment_frozen_design",
  "reproducibility": {
    "experiment_seeds": [
      42,
      123,
      456,
      789,
      2026
    ],
    "fixed_split_seed": 42,
    "primary_precision": "fp32",
    "gradient_accumulation_steps": 1,
    "full_training_before_smoke_tests_pass": false
  },
  "scratch_controlled": {
    "datasets": [
      "ag_news",
      "dbpedia_14"
    ],
    "models": [
      "medium-4",
      "large-6"
    ],
    "max_length": 128,
    "batch_size": 32,
    "epochs": 30,
    "early_stopping_patience": 5,
    "train_fraction": 1.0,
    "validation_ratio": 0.15,
    "optimizer": {
      "name": "Adam",
      "beta1": 0.9,
      "beta2": 0.98,
      "epsilon": 1e-09,
      "gradient_clip_norm": 1.0
    },
    "stable_schedule": {
      "base_lr": 0.0001,
      "warmup_steps": 8000,
      "total_steps": 50000,
      "post_warmup": "cosine"
    },
    "legacy_schedule": {
      "initial_optimizer_lr": 1.0,
      "warmup_steps": 8000,
      "formula": "d_model^(-1/2) * min(t^(-1/2), t * warmup_steps^(-3/2))",
      "indexing": "one_based"
    }
  },
  "pretrained_common": {
    "optimizer": {
      "name": "torch.optim.AdamW",
      "beta1": 0.9,
      "beta2": 0.999,
      "epsilon": 1e-08,
      "weight_decay": 0.01,
      "exclude_bias_and_norm_from_weight_decay": true
    },
    "scheduler": {
      "type": "linear_warmup_linear_decay",
      "warmup_ratio": 0.1,
      "warmup_steps_rule": "ceil(total_optimizer_steps * warmup_ratio)",
      "indexing": "one_based",
      "safe_semantics": "install intended LR before optimizer.step",
      "late_semantics": "optimizer.step consumes entry LR; intended LR installed after transition"
    },
    "gradient_clip_norm": 1.0,
    "gradient_accumulation_steps": 1,
    "precision": "fp32",
    "epochs": 3,
    "evaluation_frequency": "epoch",
    "save_final_and_validation_best": true
  },
  "pretrained_environments": {
    "ag_news_distilbert": {
      "dataset": "ag_news",
      "model": "distilbert/distilbert-base-uncased",
      "task": "sequence_classification",
      "peak_lr": 2e-05,
      "train_batch_size": 32,
      "eval_batch_size": 64,
      "max_length": 128,
      "primary_metric": "macro_f1"
    },
    "dbpedia_distilbert": {
      "dataset": "dbpedia_14",
      "model": "distilbert/distilbert-base-uncased",
      "task": "sequence_classification",
      "peak_lr": 2e-05,
      "train_batch_size": 32,
      "eval_batch_size": 64,
      "max_length": 128,
      "primary_metric": "macro_f1"
    },
    "wnut17_distilbert": {
      "dataset": "wnut_17",
      "model": "distilbert/distilbert-base-uncased",
      "task": "token_classification_ner",
      "peak_lr": 2e-05,
      "train_batch_size": 16,
      "eval_batch_size": 32,
      "max_length": 128,
      "split_policy": "official_train_validation_test",
      "primary_metric": "entity_f1",
      "label_alignment": "first_subtoken_only; special/additional subtokens=-100"
    },
    "cifar10_deit": {
      "dataset": "cifar10",
      "model": "facebook/deit-tiny-patch16-224",
      "task": "image_classification",
      "peak_lr": 5e-05,
      "train_batch_size": 32,
      "eval_batch_size": 64,
      "epochs": 3,
      "validation_size": 5000,
      "validation_split": "stratified_seed_42",
      "input_resolution": 224,
      "primary_metric": "accuracy"
    }
  },
  "guard_protocol": {
    "ratio": "||theta_after-theta_before||_2 / ||theta_before||_2",
    "calibration_window_steps": {
      "start": 1,
      "end": 100
    },
    "dense_trace_steps": {
      "start": 1,
      "end": 300
    },
    "primary_kappa": 10.0,
    "kappa_sensitivity": [
      1.1,
      2.0,
      5.0,
      10.0,
      20.0,
      50.0,
      100.0,
      200.0,
      500.0,
      1000.0
    ],
    "primary_calibration": {
      "method": "leave_one_seed_out",
      "rule": "tau = kappa * max safe ratio over steps 1..100 from the other four seeds",
      "held_out_seed_safe_data_excluded": true
    },
    "secondary_analyses": [
      "cross_model_transfer",
      "cross_dataset_transfer",
      "cross_task_transfer_where_comparable"
    ]
  },
  "mismatch_severity_diagnostic": {
    "full_training": false,
    "scope": "early_transition_counterfactual_only",
    "multipliers_relative_to_intended_lr": [
      1,
      2,
      5,
      10,
      25,
      50,
      100
    ],
    "include_natural_late_schedule_lr": true
  },
  "checkpoint_selection": {
    "never_select_on_test": true,
    "scratch": "best_validation_loss",
    "sequence_classification": "best_validation_macro_f1",
    "token_classification": "best_validation_entity_f1",
    "image_classification": "best_validation_accuracy"
  }
}
